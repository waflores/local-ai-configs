{
  "name": "llama-swap + continue.dev",
  "version": "1.0.0",
  "description": "Local LLM setup using llama-swap integrated with continue.dev VSCode extension",
  
  "authority": {
    "folder": ".continue",
    "priority": "high"
  },
  
  "core_stack": {
    "continue.dev": {
      "description": "IDE agent for AI-assisted development",
      "status": "active"
    },
    "llama-server": {
      "description": "Inference engine",
      "status": "active"
    },
    "llama-swap": {
      "description": "Model management tool",
      "status": "active"
    }
  },
  
  "model_location": "/home/waflores/.lmstudio/models",
  
  "configuration_paths": {
    "llama_swap": "/home/waflores/DevFolder/ai/local-config/llama-swap/config.yaml",
    "llama_server": "/home/waflores/DevFolder/ai/local-config/llama-swap/config.yaml"
  },
  
  "gpu_strategy": {
    "active_models": {
      "device": "CUDA",
