{
  "name": "local-config",
  "version": "1.0.0",
  "description": "LLM manager and llama-swap configuration toolkit",

  "authority": {
    "folder": ".agents",
    "priority": "high"
  },

  "core_stack": {
    "llama-server": {
      "description": "Inference engine",
      "status": "active"
    },
    "llama-swap": {
      "description": "Model management tool",
      "status": "active"
    },
    "nix": {
      "description": "Dependency and build system",
      "status": "active"
    }
  },

  "model_location": "/home/waflores/.lmstudio/models",

  "configuration_paths": {
    "llama_swap": "/home/waflores/DevFolder/ai/local-config/llama-swap/config.yaml"
  },

  "performance_targets": {
    "model_swap_time": "< 2s",
    "generation_speed_7b": "> 10 t/s",
    "vram_utilization": "< 70%",
    "context_window": "32K+"
  },

  "agents": {
    "folder": ".agents/agents",
    "primary_contract": ".agents/agents/PROJECT-CONTRACT.md"
  },

  "prompts": {
    "folder": ".agents/prompts"
  },

  "rules": {
    "folder": ".agents/rules"
  },

  "checks": {
    "folder": ".agents/checks"
  },

  "get_started": {
    "step_1": "Consult .agents/agents/PROJECT-CONTRACT.md for project overview and critical rules",
    "step_2": "Start llama-swap with /home/waflores/bin/llama-swap-config /home/waflores/DevFolder/ai/local-config/llama-swap/config.yaml -watch-config",
    "step_3": "Use 'cn' to chat with models"
  },

  "hardware": {
    "cpu": "Intel Core Ultra 9 275HX (24 cores, up to 5.4 GHz)",
    "gpu": "NVIDIA GeForce RTX 5070 Max-Q (~8 GB VRAM) + Intel Integrated Graphics (~23 GB shared)",
    "ram": "~33 GB total (~20 GB currently used)",
    "storage": "~1 TB total (~245 GB free)",
    "os": "Ubuntu 26.04 LTS (Resolute Raccoon)"
  },

  "available_devices": {
    "CUDA0": {
      "name": "NVIDIA GeForce RTX 5070 Laptop GPU",
      "memory": "7707 MiB",
      "free": "4 MiB"
    },
    "Vulkan0": {
      "name": "Intel(R) Graphics (ARL)",
      "memory": "23633 MiB",
      "free": "11154 MiB"
    },
    "Vulkan1": {
      "name": "NVIDIA GeForce RTX 5070 Laptop GPU",
      "memory": "8151 MiB",
      "free": "4 MiB"
    },
    "BLAS": {
      "name": "OpenBLAS",
      "type": "CPU offloading"
    }
  }
}